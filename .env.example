# Copie ce fichier en .env et renseigne les clés dont tu as besoin.
# .env n'est PAS commité (cf. .gitignore).

# --- LLM ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Agrégateur cloud image/vidéo (fal.ai) ---
FAL_KEY=

# --- HuggingFace ---
# Requis UNIQUEMENT pour les modèles "gated" (accès restreint), dont
# Stable Audio 3. SDXL, Kokoro et MusicGen n'en ont pas besoin.
# Jeton en LECTURE : https://huggingface.co/settings/tokens
# Il faut aussi avoir accepté la licence sur la page de chaque modèle.
HF_TOKEN=

# Ollama (LLM local) ne nécessite aucune clé, juste le serveur lancé localement.
